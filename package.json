{
  "name": "cinderdeep",
  "version": "0.1.0",
  "private": true,
  "description": "Cinderdeep - a 2D side-scrolling action RPG roguelite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/playtest-sim.ts",
    "smoke": "tsx tools/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "1.56.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
