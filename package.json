{
  "name": "cinderdeep",
  "version": "0.1.0",
  "private": true,
  "description": "Cinderdeep - a 2D side-scrolling action RPG roguelite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/playtest-sim.ts",
    "smoke": "tsx tools/smoke.ts",
    "build:single": "tsc --noEmit && vite build --mode single && node -e \"const f=require('fs');f.renameSync('dist-single/index.html','dist-single/cinderdeep.html');f.mkdirSync('play',{recursive:true});f.copyFileSync('dist-single/cinderdeep.html','play/cinderdeep.html')\"",
    "play": "vite --open",
    "build:artifact": "npm run build:single && node tools/make-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "1.56.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.6",
    "@fontsource/source-sans-3": "^5.2.8"
  }
}
